# Copiez ce fichier vers .streamlit/secrets.toml (en local) ou collez son
# contenu dans Settings > Secrets sur Streamlit Community Cloud.
# Ne JAMAIS committer le vrai fichier secrets.toml dans Git.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"

# Clé "anon" / "public" — Supabase Dashboard > Project Settings > API
SUPABASE_ANON_KEY = "eyJ..."

# Clé "service_role" — même page, section "service_role" (secrète !)
# Utilisée uniquement par le tableau de bord admin, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY = "eyJ..."

# Mot de passe pour accéder au tableau de bord admin
ADMIN_PASSWORD = "changez-moi"

# ------------------------------------------------------------------
# Adresse publique de l'app (optionnel mais recommandé).
# Sert à composer les liens de commande personnels des détaillants
# affichés dans le tableau de bord : <APP_URL>/?c=XXXXXXXX
# Sans cette valeur, le tableau de bord n'affiche que la partie « ?c=... ».
# ------------------------------------------------------------------
APP_URL = "https://votre-app.streamlit.app"

# ------------------------------------------------------------------
# Aucun autre secret n'est requis : la table `retailers` et la fonction
# `retailer_by_code` sont créées par supabase_schema.sql et utilisent les
# mêmes clés que ci-dessus.
#   - la clé anon ne peut que RÉSOUDRE un code de détaillant à la fois
#     (fonction retailer_by_code), jamais lister la clientèle ;
#   - la clé service_role gère produits et détaillants depuis le tableau
#     de bord, après saisie de ADMIN_PASSWORD.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Courriels automatiques (optionnel — sans ces valeurs, l'app fonctionne
# exactement comme avant, elle n'envoie simplement rien).
#
# SMTP d'une boîte que vous possédez déjà. Avec Gmail ou Microsoft 365,
# SMTP_PASSWORD doit être un « mot de passe d'application », pas le mot de
# passe du compte.
#   Gmail            : smtp.gmail.com, port 587
#   Microsoft 365    : smtp.office365.com, port 587
#   Beaucoup d'hébergeurs : mail.votredomaine.ca, port 465
# ------------------------------------------------------------------
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "commandes@mine-de-ketchup.ca"
SMTP_PASSWORD = "mot-de-passe-d-application"

# Adresse affichée comme expéditeur (par défaut : SMTP_USER)
SMTP_FROM = "commandes@mine-de-ketchup.ca"

# Chiffrement : déduit du port si absent (465 -> ssl, sinon starttls).
# À forcer seulement si votre hébergeur écoute le TLS implicite sur un autre port.
# SMTP_SECURITY = "ssl"

# Qui reçoit l'alerte à chaque nouvelle commande (séparer par des virgules)
ORDER_NOTIFY_EMAIL = "gui@mine-de-ketchup.ca"

# Qui reçoit le rapport hebdomadaire — utilisé par le script, pas par l'app
ACCOUNTANT_EMAIL = "comptable@exemple.ca"
