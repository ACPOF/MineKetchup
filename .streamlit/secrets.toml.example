# Copiez ce fichier vers .streamlit/secrets.toml (en local) ou collez son
# contenu dans Settings > Secrets sur Streamlit Community Cloud.
# Ne JAMAIS committer le vrai fichier secrets.toml dans Git.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"

# Clé "anon" / "public" — Supabase Dashboard > Project Settings > API
SUPABASE_ANON_KEY = "eyJ..."

# Clé "service_role" — même page, section "service_role" (secrète !)
# Utilisée uniquement par le tableau de bord admin, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY = "eyJ..."

# Mot de passe pour accéder au tableau de bord admin
ADMIN_PASSWORD = "changez-moi"

# ------------------------------------------------------------------
# Aucun secret supplémentaire n'est requis par la version « détaillants
# enregistrés » : la table `retailers` et la vue `retailers_public` sont
# créées par supabase_schema.sql et utilisent les mêmes clés ci-dessus.
#   - la clé anon lit la vue `retailers_public` (id + nom du commerce) ;
#   - la clé service_role gère produits et détaillants depuis le tableau
#     de bord, après saisie de ADMIN_PASSWORD.
# ------------------------------------------------------------------
