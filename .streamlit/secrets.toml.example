# Copiez ce fichier vers .streamlit/secrets.toml (en local) ou collez son
# contenu dans Settings > Secrets sur Streamlit Community Cloud.
# Ne JAMAIS committer le vrai fichier secrets.toml dans Git.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"

# Clé "anon" / "public" — Supabase Dashboard > Project Settings > API
SUPABASE_ANON_KEY = "eyJ..."

# Clé "service_role" — même page, section "service_role" (secrète !)
# Utilisée uniquement par le tableau de bord admin, jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY = "eyJ..."

# Mot de passe pour accéder au tableau de bord admin
ADMIN_PASSWORD = "changez-moi"

# ------------------------------------------------------------------
# Adresse publique de l'app (optionnel mais recommandé).
# Sert à composer les liens de commande personnels des détaillants
# affichés dans le tableau de bord : <APP_URL>/?c=XXXXXXXX
# Sans cette valeur, le tableau de bord n'affiche que la partie « ?c=... ».
# ------------------------------------------------------------------
APP_URL = "https://votre-app.streamlit.app"

# ------------------------------------------------------------------
# Aucun autre secret n'est requis : la table `retailers` et la fonction
# `retailer_by_code` sont créées par supabase_schema.sql et utilisent les
# mêmes clés que ci-dessus.
#   - la clé anon ne peut que RÉSOUDRE un code de détaillant à la fois
#     (fonction retailer_by_code), jamais lister la clientèle ;
#   - la clé service_role gère produits et détaillants depuis le tableau
#     de bord, après saisie de ADMIN_PASSWORD.
# ------------------------------------------------------------------
